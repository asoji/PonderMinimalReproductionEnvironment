{
  "schemaVersion": 1,
  "id": "ponderminimalreproduction",
  "version": "${version}",
  "name": "Ponder Minimal Reproduction",
  "description": "This is a minimal reproduction environment used for reporting Ponder bugs",
  "authors": [
    "asoji"
  ],
  "contact": {
    "sources": "https://github.com/asoji/PonderMinimalReproductionEnvironment"
  },
  "license": "MIT",
  "icon": "assets/ponderminimalreproduction/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "gay.asoji.ponderminimalreproduction.PonderMinimalReproduction"
    ],
    "client": [
      "gay.asoji.ponderminimalreproduction.client.PonderMinimalReproductionClient"
    ]
  },
  "mixins": [
    "ponderminimalreproduction.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fapi_version}",
    "minecraft": "${minecraft_dependency}"
  }
}
